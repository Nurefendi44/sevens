# SUPABASE CONFIGURATION FOR ONLINE MULTIPLAYER
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# TURN SERVER UNTUK LIVE VOICE (WAJIB agar suara jalan di jaringan seluler/hotspot/NAT ketat)
# Opsi A (disarankan, gratis 20GB/bulan): daftar di https://dashboard.metered.ca/signup
# lalu buat App -> isi domain app & API key (Developers -> TURN Credentials API)
VITE_METERED_DOMAIN=your-app-name.metered.live
VITE_METERED_API_KEY=your_metered_api_key

# Opsi B: TURN server sendiri / provider lain (pisahkan URL dengan koma)
# VITE_TURN_URLS=turn:your.turn.host:3478,turn:your.turn.host:443?transport=tcp
# VITE_TURN_USERNAME=username
# VITE_TURN_CREDENTIAL=password
